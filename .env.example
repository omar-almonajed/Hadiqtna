# APP_URL: The public HTTPS URL where this applet is deployed (required for ESP32 cloud reachability).
# NOTE: Do NOT use ai-studio ais-dev-* authenticated preview URLs for unattended ESP32 devices.
APP_URL="MY_APP_URL"

# PORT: HTTP server port (required 3000 in AI Studio preview)
PORT=3000

# CORS_ORIGINS: Comma-separated allowed origins (leave empty for same-origin + APP_URL)
CORS_ORIGINS=""

# BOOTSTRAP_ADMIN_EMAIL: Primary verified administrator email
BOOTSTRAP_ADMIN_EMAIL="mralmnjd363@gmail.com"

# FIREBASE_SERVICE_ACCOUNT_KEY: Required in Cloud Run / Central Production for Admin Firestore writes.
# Provide raw JSON string or base64-encoded service account JSON for project premium-apogee-mn50x.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# --- Local Park / Municipality Server Fallback Options ---
# LOCAL_SERVER_MODE: Set to "true" when running as an optional local LAN/municipality server.
LOCAL_SERVER_MODE="false"

# HADIQTNA_DATA_DIR: Non-/tmp persistent volume path when LOCAL_SERVER_MODE=true (e.g. /var/lib/hadiqtna/data).
# Production central servers MUST NOT rely on /tmp.
HADIQTNA_DATA_DIR=""

# ALLOW_EPHEMERAL_LOCAL_STORE: Set to "true" ONLY for temporary/sandbox testing without Firestore Admin credentials.
ALLOW_EPHEMERAL_LOCAL_STORE="false"

# CENTRAL_SYNC_URL: Public HTTPS URL of the central Hadiqtna server (used when LOCAL_SERVER_MODE=true).
CENTRAL_SYNC_URL=""

# SYNC_SHARED_SECRET: Strong shared secret (>=16 chars) authenticating local-to-central batch sync (/api/iot/sync/ingest).
SYNC_SHARED_SECRET=""

# --- Safe Staff Login Alternative (No +963 SMS Phone Auth) ---
# LOCAL_STAFF_AUTH_ENABLED: Enable scrypt + HMAC-SHA256 staff login on local servers or when Google OAuth is blocked.
LOCAL_STAFF_AUTH_ENABLED="false"

# LOCAL_AUTH_SECRET: Strong secret (>=16 chars) used to sign local staff session tokens.
LOCAL_AUTH_SECRET=""
